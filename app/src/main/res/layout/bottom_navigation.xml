<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/navigation_background"
    android:elevation="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- 地图标签 -->
    <FrameLayout
        android:id="@+id/nav_map"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_map_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_map"
                android:tint="@color/navigation_selected" />

            <TextView
                android:id="@+id/nav_map_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="地图"
                android:textColor="@color/navigation_selected"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- 位置标签 -->
    <FrameLayout
        android:id="@+id/nav_locations"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_locations_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_location"
                android:tint="@color/navigation_unselected" />

            <TextView
                android:id="@+id/nav_locations_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="位置"
                android:textColor="@color/navigation_unselected"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 设置标签 -->
    <FrameLayout
        android:id="@+id/nav_settings"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_settings_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/navigation_unselected" />

            <TextView
                android:id="@+id/nav_settings_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="设置"
                android:textColor="@color/navigation_unselected"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
